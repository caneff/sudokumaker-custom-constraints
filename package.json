{
  "name": "sudokumaker-custom-constraints",
  "version": "0.0.0",
  "private": true,
  "description": "Worked examples of custom SudokuMaker constraint components.",
  "scripts": {
    "lint": "standard",
    "test": "node examples/_shared/recovery-lib.test.mjs && node examples/hit-counts/recovery-probe.test.mjs && node examples/skyscraper/recovery-probe.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "standard": "^17.1.2"
  },
  "standard": {
    "//": "The .js files are constraint snippets pasted into SudokuMaker. `globals` names the API globals SudokuMaker injects (helpers, SudokuDigitSet) and the component constructors main.js references; each component file disables no-unused-vars for its API functions. `ignore` holds only the verbatim original/ comparison files, which must stay exactly as their author wrote them.",
    "ignore": [
      "examples/numbered-rooms/original/main.js",
      "examples/numbered-rooms/original/CustomIndexComponent.js",
      "examples/skyscraper/original/CustomSkyscraperLineComponent.js",
      "examples/skyscraper/original/main.js"
    ],
    "globals": [
      "SudokuDigitSet",
      "helpers",
      "input",
      "puzzle",
      "SudokuMaker",
      "SkyscraperLineComponent",
      "SkyscraperOneSidedComponent",
      "SkyscraperSideComponent",
      "HitCountsJointComponent",
      "HitCountsComponent",
      "IsofillComponent",
      "SideSumComponent",
      "SideHitMatchingComponent",
      "NumberedRoomsComponent",
      "OutsideSudokuComponent",
      "NumberedRoomsLinesComponent",
      "NumberedRoomsPairComponent",
      "RunningStartComponent",
      "RunningStartPairComponent",
      "CustomSkyscraperLineComponent",
      "CustomIndexComponent"
    ]
  }
}
